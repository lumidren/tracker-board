  (rectangle (start 12.7 12.7) (end 180.34 132.08) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid fd4eab55-2f61-5642-a9d3-ff760e9b74b2))
  (text "1  Vehicle input and protection" (at 15.24 19.05 0) (effects (font (size 2.54 2.54)) (justify left bottom)) (uuid f900eccc-3b3d-502c-9b35-a3c687f43636))
  (text "9 to 32 V in (the surge diode stays off up to 33 V). D2 is rated for the capacitor voltage plus a negative surge, so 100 V." (at 15.24 22.2 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid ac30e403-dc54-54f4-88fd-66c4c202567b))
  (rectangle (start 187.96 12.7) (end 355.6 83.82) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid 2c88e570-9fa3-55b0-94c8-cca4ef0f104f))
  (text "2  Vehicle supply down to 5 V" (at 190.5 19.05 0) (effects (font (size 2.54 2.54)) (justify left bottom)) (uuid 337c9ce5-e8d6-5318-a222-7539dd5bf80f))
  (text "LM2596HV: 60 V input rating. This rail feeds the charger and nothing else." (at 190.5 22.2 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid d64d8f06-5d4d-566d-bfe7-f4060e3ac0b8))
  (rectangle (start 363.22 12.7) (end 530.86 144.78) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid 96229a00-2918-5bf2-8777-708858e40ad8))
  (text "3  Charger and backup battery" (at 365.76 19.05 0) (effects (font (size 2.54 2.54)) (justify left bottom)) (uuid f200a7cb-2f00-543c-96a8-3fcb1058f772))
  (text "Power path: VSYS comes from the input when it is present, from the cell when it is not." (at 365.76 22.2 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 6303addd-b9d7-57b8-9a4f-cdf740e86b06))
  (rectangle (start 538.48 12.7) (end 706.12 106.68) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid 6bdf9d44-f52c-5ee9-b516-8c9527bc4e3f))
  (text "4  Logic supply, 3.3 V" (at 541.02 19.05 0) (effects (font (size 2.54 2.54)) (justify left bottom)) (uuid 6cbf9b50-2257-5519-9aa8-a43313f729d4))
  (text "Fed from VSYS so the processor keeps running on the battery." (at 541.02 22.2 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid ca66c994-3d77-5b18-b32c-9106d7a5cf2e))
  (rectangle (start 12.7 152.4) (end 180.34 304.8) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid 7788861e-7981-5f7b-b93c-89e20e2d919e))
  (text "5  Modem supply, 3.8 V" (at 15.24 158.75 0) (effects (font (size 2.54 2.54)) (justify left bottom)) (uuid d8c71c92-4c37-533f-b60c-b90ba7305664))
  (text "Buck-boost keeps the modem at 3.8 V from a full cell down to an empty one. EN low removes the supply." (at 15.24 161.9 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 37ab7f71-10ea-5bc7-8d5d-bb833ec50833))
  (rectangle (start 187.96 152.4) (end 360.68 248.92) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid 9d4cb153-054b-5045-b818-bd6d0649e331))
  (text "6  Switched 5 V for the GNSS module and the sensor cable" (at 190.5 158.75 0) (effects (font (size 2.54 2.54)) (justify left bottom)) (uuid 14416b87-5bfc-5d0b-b2a5-a69103028c14))
  (text "Stepped up from VSYS, so position and cargo readings carry on when the vehicle supply is cut. 5V_SW_EN low switches both off. A short latches the switch off until 5V_SW_EN is toggled." (at 190.5 161.9 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 54ba7d97-e905-5bb8-85bd-636768800b15))
  (rectangle (start 368.3 152.4) (end 642.62 401.32) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid ea38fc87-80f8-5225-a6cb-afa59c484597))
  (text "7  LTE modem and SIM" (at 370.84 158.75 0) (effects (font (size 2.54 2.54)) (justify left bottom)) (uuid e7f12897-e04e-50ac-b611-33c9b9bfe57a))
  (text "A7670 logic is 1.8 V. The translator is powered from the modem, so it lets go of the lines when the modem is off." (at 370.84 161.9 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 0dd75c6e-a10f-5980-b07c-a20d7d9fb421))
  (rectangle (start 12.7 408.94) (end 180.34 548.64) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid a093c9a0-0688-5828-bbe4-48bb0feaa90f))
  (text "8  Processor" (at 15.24 415.29 0) (effects (font (size 2.54 2.54)) (justify left bottom)) (uuid e693f5b7-5074-53a5-af23-a14cacb95a02))
  (text "ESP32-S3-WROOM-1-N8. IO3, IO45 and IO46 set the start-up mode and stay unconnected. IO35 to IO37 are usable on the N8 (no PSRAM)." (at 15.24 418.44 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 4d978781-e190-58b1-a055-73ccd2900939))
  (rectangle (start 187.96 408.94) (end 355.6 520.7) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid 60520541-6b7e-5296-8175-e4815f0fb223))
  (text "9  USB-C and programming header" (at 190.5 415.29 0) (effects (font (size 2.54 2.54)) (justify left bottom)) (uuid 41aba6ac-50be-5a31-bcd1-e2536923f13c))
  (text "USB-C carries data only. Power the board from the vehicle connector or the battery." (at 190.5 418.44 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 6d3df3d9-bcde-5503-adfc-a36695df1e93))
  (rectangle (start 363.22 408.94) (end 530.86 485.14) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid a4719fc7-0070-54fa-b81a-b88ff643cbe8))
  (text "10  GNSS module" (at 365.76 415.29 0) (effects (font (size 2.54 2.54)) (justify left bottom)) (uuid 4d5935d2-af83-5f3d-8d27-6cd57674908f))
  (text "NEO-7M module on a header, powered from the switched 5 V rail. Use an external active antenna." (at 365.76 418.44 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 2f453120-9e03-58bd-9355-5db656cc892d))
  (rectangle (start 538.48 408.94) (end 706.12 518.16) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid b88847dd-5aed-5e19-972c-779bdc175d08))
  (text "11  RS-485 sensor bus" (at 541.02 415.29 0) (effects (font (size 2.54 2.54)) (justify left bottom)) (uuid a3d29166-a613-52d0-9da2-d3e48f7508a5))
  (text "The tracker is the master at one end of the cable: bias and termination are fitted here." (at 541.02 418.44 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid e95a4a79-ee2b-5484-ab99-5487140877d3))
  (rectangle (start 12.7 556.26) (end 180.34 652.78) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid 1ba942fa-fba7-54b3-933f-5731b838719b))
  (text "12  Door inputs" (at 15.24 562.61 0) (effects (font (size 2.54 2.54)) (justify left bottom)) (uuid 2f337c12-ab49-568b-9766-714b6ded0adb))
